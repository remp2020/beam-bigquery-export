# Elasticsearch connection string of REMP Beam, e.g. https://username:password@elastic.example.com:9200/
ELASTIC_CONNECTION=

# Prefix of Beam's index names, if your installation uses one (can be empty)
ELASTIC_PREFIX=

# Indices to export (comma-separated); each needs a schema file in bq/
# BEAM_INDICES=pageviews,pageviews_time_spent,pageviews_progress,events,commerce,impressions

# Target BigQuery project and dataset
BQ_PROJECT_ID=
BQ_DATASET_ID=

# Optional: Sentry DSN for error reporting (used only if sentry-cli is installed)
SENTRY_DSN=
